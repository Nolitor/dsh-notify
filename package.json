{
  "name": "@nolit/dsh-notify-web",
  "version": "0.0.1-rc.3",
  "description": "Notify for Chrome: Chrome notification alerts for DeepSeek Harness turns, approvals, questions and errors, with a silent in-app toast fallback.",
  "license": "MIT",
  "author": "nolit",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.src.js",
    "lib/locale-table.js",
    "scripts/gen-locale.mjs",
    "scripts/build-client.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "market/index.json",
    "market/icons/*.svg",
    "README.md",
    "CHANGELOG.md",
    "docs/",
    "LICENSE",
    "test/client.test.mjs",
    "test/typography.test.mjs",
    "test/locale.test.mjs",
    "test/manifest.test.mjs",
    "package.json",
    "test/peak.test.mjs"
  ],
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "scripts": {
    "build": "node scripts/gen-locale.mjs && node scripts/build-client.mjs",
    "pretest": "npm run build",
    "test": "node --test test/client.test.mjs test/typography.test.mjs test/locale.test.mjs test/manifest.test.mjs test/peak.test.mjs",
    "docs:index": "node ../scripts/doc-index-track.mjs",
    "docs:check": "node ../scripts/doc-index-track.mjs --check"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "notifications",
    "chrome",
    "web-notification",
    "browser"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
