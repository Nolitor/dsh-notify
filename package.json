{
  "name": "@nolit/dsh-notify-web",
  "version": "0.1.7",
  "description": "Browser-only turn, approval, question, and error notifications for DeepSeek Harness.",
  "license": "MIT",
  "author": "nolit",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "market/index.json",
    "market/icons/*.svg",
    "README.md",
    "LICENSE",
    "test/client.test.mjs",
    "package.json"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1"
  },
  "scripts": {
    "test": "node --test test/client.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "notifications",
    "web",
    "browser"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
